 NEVER commit backend/.env.sh.
#
#   cd backend
#   echo "export MASTER_KEY=$(openssl rand -base64 32)" > .env.sh
#   source .env.sh
#
# MASTER_KEY derives every file's AES-256-GCM encryption key.
# Create it ONCE and keep it: if it is lost, files already stored on IPFS can never be decrypted.
export MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
